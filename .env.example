# OilEnergy environment configuration
# Copy this file to .env and fill in your values.
# .env is in .gitignore and will NOT be committed to the repository.

# HuggingFace Inference API token (free — get yours at https://huggingface.co/settings/tokens)
# Required for AI-powered result interpretation (facebook/bart-large-cnn model).
# If not set, the pipeline uses a template-based summary instead.
HUGGINGFACE_API_KEY=hf_your_token_here
